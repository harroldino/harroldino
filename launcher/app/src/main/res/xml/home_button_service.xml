<?xml version="1.0" encoding="utf-8"?>
<!-- Key filtering lets us take the remote's Home press before Fire OS does, so Command Centre
     opens straight away instead of after Amazon's home screen (and its ~5 s launch block). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="50"
    android:canRetrieveWindowContent="false"
    android:packageNames="com.amazon.tv.launcher"
    android:description="@string/a11y_desc" />
